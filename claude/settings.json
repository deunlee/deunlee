{
  "cleanupPeriodDays": 14,
  "env": {
    "DO_NOT_TRACK": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-opus-5",
    "PYTHONIOENCODING": "utf-8",
    "GITHUB_PERSONAL_ACCESS_TOKEN": "github_pat_[REDACTED]",
    "CONTEXT7_API_KEY": "ctx7sk-[REDACTED]",
    "TAVILY_API_KEY": "tvly-dev-[REDACTED]"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(//**/.env)",
      "Read(~/.ssh/**)",
      "Read(~/.claude*/.credentials.json)"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ~/.claude1/statusline.ps1",
    "refreshInterval": 30
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ~/.claude1/statusline-sub.ps1"
  },
  "enabledPlugins": {
    "code-review@anthropic-plugin-directory": true,
    "code-simplifier@anthropic-plugin-directory": true,
    "context7@anthropic-plugin-directory": true,
    "feature-dev@anthropic-plugin-directory": true,
    "exa@claude-plugins-official": true,
    "fluent-korean@fluent-korean": true,
    "frontend-design@anthropic-plugin-directory": true,
    "github@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "plugin-dev@anthropic-plugin-directory": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "skill-creator@anthropic-plugin-directory": true,
    // "superpowers@claude-plugins-official": true,
    "tavily@anthropic-plugin-directory": true,
    "typescript-lsp@claude-plugins-official": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true
  },
  "extraKnownMarketplaces": {
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    },
    "fluent-korean": {
      "source": {
        "source": "github",
        "repo": "snflkd/fluent-korean"
      }
    }
  },
  "language": "Korean",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "remoteControlAtStartup": false
}
